# The site is built by .github/workflows/deploy.yml on the exact versions
# pinned here, so a local `bundle exec jekyll serve` matches production.
#
#   bundle install
#   bundle exec jekyll serve      # http://127.0.0.1:4000
#
# Needs Ruby >= 3.0 (macOS system Ruby is 2.6): brew install ruby
source "https://rubygems.org"

gem "jekyll", "~> 4.4"
gem "jekyll-sitemap", "~> 1.4"

gem "jekyll-feed", "~> 0.17"
